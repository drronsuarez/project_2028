{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project2028tv",
  "compatibility_date": "2026-05-09",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "npm run build",
    "cwd": "client",
    "watch_paths": ["src/**/*.{ts,tsx,css}"]
  },
  "assets": {
    "directory": "client/dist"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
